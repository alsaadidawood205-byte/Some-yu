local keepKeywords = {"hair","afro","ponytail","bang","braid","wig","longhair","shorthair","topknot"}

local function lower(s) return (s or ""):lower() end
local function formatTime(seconds)
    local mins = math.floor(seconds / 60)
    local secs = seconds % 60
    return string.format("%02d:%02d", mins, secs)
end

local function isHair(acc)
    if not acc or not acc.Name then return false end
    for _, kw in ipairs(keepKeywords) do if string.find(lower(acc.Name), kw, 1, true) then return true end end
    return false
end

local function simplifyTarget(player)
    if not player or not player.Character then return end
    local char = player.Character
    for _, item in ipairs(char:GetDescendants()) do      
        if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or (item:IsA("Decal") and item.Name == "face") then      
            item.Parent = nil      
        end      
    end      
    for _, acc in ipairs(char:GetChildren()) do      
        if acc:IsA("Accessory") and not isHair(acc) then acc.Parent = nil end      
    end
end

local function MakeDraggable(ui, draghandle)
    local dragging, dragStart, startPos
    draghandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = ui.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            ui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function() dragging = false end)
end

